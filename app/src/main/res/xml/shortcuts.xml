<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_voice_expense_short"
        android:shortcutLongLabel="@string/shortcut_voice_expense_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example"
            android:targetClass="com.example.MainActivity">
            <extra android:name="navigate_to" android:value="voice_expense" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

